---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
import { homeContent } from '../content/home.es';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const {
  title = homeContent.meta.title,
  description = homeContent.meta.description,
  noIndex = false
} = Astro.props;

const loadSimpleAnalytics = __DAB_ANALYTICS_PRODUCTION__;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://dabtech.me');

const jsonLdOrg = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "DAB Tech",
  "url": "https://dabtech.me",
  "description": description,
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "Estado de México",
    "addressCountry": "MX"
  }
};

const jsonLdService = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Instalación de sistemas operados por IA para workflows empresariales",
  "provider": {
    "@type": "Organization",
    "name": "DAB Tech"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Mexico"
  }
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <!-- Preload Hero Poster for Instant LCP -->
    <link rel="preload" as="image" href="/assets/hero/hero-workflows-poster.webp" type="image/webp" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://dabtech.me/assets/hero/hero-workflows-poster.webp" />
    <meta property="twitter:image" content="https://dabtech.me/assets/hero/hero-workflows-poster.webp" />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Self-Hosted Fonts Preload -->
    <link rel="preload" href="/fonts/instrument-sans/instrument-sans-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans/instrument-sans-600-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Simple Analytics Official Script (PROD & ENABLED only) -->
    {loadSimpleAnalytics && (
      <script is:inline>
        if (location.origin === 'https://dabtech.me') {
          window.sa_event = window.sa_event || function () { (window.sa_event.q = window.sa_event.q || []).push(arguments); };
          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://scripts.simpleanalyticscdn.com/latest.js';
          script.dataset.hostname = 'dabtech.me';
          document.head.appendChild(script);
        }
      </script>
    )}

    <!-- JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdOrg)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdService)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
