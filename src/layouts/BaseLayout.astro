---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
import { homeContent } from '../content/home.es';
import { absoluteSiteUrl, siteIdentity } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const {
  title = homeContent.meta.title,
  description = homeContent.meta.description,
  noIndex = false
} = Astro.props;

const loadSimpleAnalytics = __DAB_ANALYTICS_PRODUCTION__;

const path = Astro.url.pathname;
const canonicalPath = path.endsWith('/') || path.includes('.') ? path : `${path}/`;
const canonicalURL = new URL(canonicalPath, Astro.site || siteIdentity.url);
const socialImageURL = absoluteSiteUrl(siteIdentity.assets.socialImage);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": absoluteSiteUrl('#organization'),
      "name": siteIdentity.name,
      "alternateName": siteIdentity.alternateName,
      "url": siteIdentity.url,
      "logo": absoluteSiteUrl(siteIdentity.assets.logo),
      "description": siteIdentity.description,
      "address": {
        "@type": "PostalAddress",
        "addressRegion": siteIdentity.location.region,
        "addressCountry": siteIdentity.location.countryCode
      },
      "areaServed": {
        "@type": "Country",
        "name": siteIdentity.location.country
      }
    },
    {
      "@type": "WebSite",
      "@id": absoluteSiteUrl('#website'),
      "url": siteIdentity.url,
      "name": siteIdentity.name,
      "alternateName": siteIdentity.alternateName,
      "publisher": { "@id": absoluteSiteUrl('#organization') },
      "inLanguage": siteIdentity.language
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalURL.toString()}#webpage`,
      "url": canonicalURL.toString(),
      "name": title,
      "description": description,
      "isPartOf": { "@id": absoluteSiteUrl('#website') },
      "about": { "@id": absoluteSiteUrl('#organization') },
      "inLanguage": siteIdentity.language
    }
  ]
};
---

<!DOCTYPE html>
<html lang={siteIdentity.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="describedby" href="/llms.txt" type="text/plain" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#1C241E" />
    <!-- Preload Hero Poster for Instant LCP -->
    <link rel="preload" as="image" href="/assets/hero/hero-workflows-poster.webp" type="image/webp" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteIdentity.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta property="og:image:alt" content="Representación visual de workflows operados por IA de DAB Tech" />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Representación visual de workflows operados por IA de DAB Tech" />

    <!-- Self-Hosted Fonts Preload -->
    <link rel="preload" href="/fonts/instrument-sans/instrument-sans-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans/instrument-sans-600-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Simple Analytics Official Script (PROD & ENABLED only) -->
    {loadSimpleAnalytics && (
      <script is:inline>
        if (location.origin === 'https://dabtech.me') {
          window.sa_event = window.sa_event || function () { (window.sa_event.q = window.sa_event.q || []).push(arguments); };
          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://scripts.simpleanalyticscdn.com/latest.js';
          script.dataset.hostname = 'dabtech.me';
          document.head.appendChild(script);
        }
      </script>
    )}

    <!-- JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
