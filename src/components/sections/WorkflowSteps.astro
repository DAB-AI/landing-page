---
import SectionIntro from '../ui/SectionIntro.astro';
import { homeContent } from '../../content/home.es';

const { workflowSteps } = homeContent;
---

<section class="workflow-steps section section--surface" id="pasos-workflow">
  <div class="container">
    <SectionIntro
      eyebrow={workflowSteps.eyebrow}
      title={workflowSteps.title}
    />

    <!-- Indexed Editorial Sequence without closed card boxes -->
    <ol class="workflow-steps__list">
      {workflowSteps.steps.map((step) => (
        <li class="workflow-step-row">
          <div class="workflow-step-row__num">{step.number}</div>
          <div class="workflow-step-row__content">
            <h3 class="workflow-step-row__title">{step.title}</h3>
            <p class="workflow-step-row__body">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .workflow-steps {
    background-color: var(--c-ivory-surface);
    border-top: 1px solid var(--c-rule-light);
    border-bottom: 1px solid var(--c-rule-light);
  }

  .workflow-steps__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
    border-top: 2px solid var(--c-ink);
  }

  .workflow-step-row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 2rem;
    padding: 1.75rem 0.5rem;
    border-bottom: 1px solid var(--c-rule-light);
    align-items: flex-start;
  }

  .workflow-step-row__num {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--c-orange-text-ivory, #A83B12);
    line-height: 1;
    padding-top: 0.2rem;
  }

  .workflow-step-row__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    color: var(--c-ink);
  }

  .workflow-step-row__body {
    font-size: 1rem;
    color: var(--c-ink-muted);
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .workflow-step-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
