---
import SectionIntro from '../ui/SectionIntro.astro';
import { homeContent } from '../../content/home.es';

const { wedgeList } = homeContent;
---

<section class="wedge-list section section--surface" id="donde-empezar">
  <div class="container">
    <SectionIntro
      eyebrow={wedgeList.eyebrow}
      title={wedgeList.title}
      intro={wedgeList.intro}
    />

    <div class="wedge-grid">
      {wedgeList.wedges.map((wedge) => (
        <article class="wedge-col">
          <div class="wedge-col__tag">{wedge.tag}</div>
          <h3 class="wedge-col__title">{wedge.title}</h3>
          <p class="wedge-col__desc">{wedge.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .wedge-list {
    background-color: var(--c-ivory-surface);
    border-top: 1px solid var(--c-rule-light);
    border-bottom: 1px solid var(--c-rule-light);
  }

  .wedge-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .wedge-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .wedge-col {
    background-color: var(--c-ivory-bg);
    border: 1px solid var(--c-rule-light);
    border-radius: var(--radius-panel);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    transition: border-color var(--duration-fast) ease;
  }

  .wedge-col:hover {
    border-color: var(--c-orange-accent);
  }

  .wedge-col__tag {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 500;
    color: var(--c-orange-text-ivory, #A83B12);
    letter-spacing: 0.05em;
    margin-bottom: 0.85rem;
    text-transform: uppercase;
  }

  .wedge-col__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--c-ink);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .wedge-col__desc {
    font-size: 0.95rem;
    color: var(--c-ink-muted);
    line-height: 1.55;
  }
</style>
